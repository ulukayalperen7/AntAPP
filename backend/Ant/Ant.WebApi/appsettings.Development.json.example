{
  // Bu dosyayı kopyalayıp appsettings.Development.json olarak kaydedin.
  // appsettings.Development.json gitignore'dadır — asla commit'lemeyin.

  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5001"
      },
      "Https": {
        "Url": "https://0.0.0.0:9001"
      }
    }
  },

  "UseInMemoryDatabase": true, // false yapıp DefaultConnection'ı doldurursanız SQL Server kullanılır

  "ConnectionStrings": {
    "DefaultConnection": "Data Source=SERVER_ADI\\SQLEXPRESS;Initial Catalog=AntAppDb;Integrated Security=True;MultipleActiveResultSets=True;TrustServerCertificate=true"
  },

  "MailSettings": {
    "EmailFrom": "test@ornek.com",
    "SmtpHost": "smtp.ethereal.email",   // Test için: https://ethereal.email
    "SmtpPort": 587,
    "SmtpUser": "ethereal_kullanici",
    "SmtpPass": "ethereal_sifre",
    "DisplayName": "AntAPP"
  },

  "JWTSettings": {
    "Key": "EN_AZ_32_KARAKTER_UZUN_GIZLI_ANAHTAR_BURAYA",
    "Issuer": "CoreIdentity",
    "Audience": "CoreIdentityUser",
    "DurationInMinutes": 15
  },

  "Google": {
    // Google API Key'in çalışması için:
    // backend/Ant/Ant.Infrastructure/ServiceRegistration.cs dosyasına gidin 
    // ve DummyMapRoutingService yerine GoogleRoutesService'i aktif edin.
    //line 48~2
    "ApiKey": "YOUR_GOOGLE_MAPS_API_KEY_HERE" 
  },

  "RouteSettings": {
    "MaxRouteDistanceKm": 50.0 // Ardışık noktalar arası izin verilen maksimum mesafe (km). Bunu aşarsa hata fırlatılır.
  }
}
